esphome:
  name: quatt-cic-bridge
  friendly_name: Quatt CiC Modbus Bridge

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: esp-idf
    
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

ota:
  - platform: esphome
    password: !secret QMB_ota

# Enable Home Assistant API
api:
  encryption:
    key: "bCgjMAuWrpWokLfGt5g7bBSIvgPFbWUDa/G3G6tgLKg="  

logger:
  level: DEBUG
  baud_rate: 0

# ====================== RS485 ======================
uart:
  id: rs485_bus
  tx_pin: GPIO9
  rx_pin: GPIO8
  rx_full_threshold: 1
  rx_timeout: 1
  baud_rate: 19200
  data_bits: 8
  parity: EVEN
  stop_bits: 1
  flow_control_pin:
    number: GPIO10
    inverted: True             # Probeer eerst true. Als geen reactie → false
  debug:
    direction: BOTH   # laat zowel TX als RX zien in logs

# ====================== Modbus Server ======================
modbus:
  - id: quatt_modbus
    uart_id: rs485_bus
    role: server
    send_wait_time: 50ms

# ====================== Modbus Slave Registers ======================
modbus_controller:
  - id: quatt_cic
    modbus_id: quatt_modbus
    address: 1
    setup_priority: -100
    update_interval: never

    server_registers:

      # --- READ-ONLY REGISTERS (Status data terug naar CiC) ---
      - address: 0x0833  # R2099
        value_type: U_WORD
        read_lambda: return 0x0000;
      - address: 0x0834  # R2100
        value_type: U_WORD
        read_lambda: return 0x00ea;
      - address: 0x0835  # R2101
        value_type: U_WORD
        read_lambda: return 0x0000;
