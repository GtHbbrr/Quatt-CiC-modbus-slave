esphome:
  name: quatt-cic-bridge
  friendly_name: Quatt CiC Modbus Bridge

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: esp-idf
    version: recommended
    sdkconfig_options:
      COMPILER_OPTIMIZATION_SIZE: y
      CONFIG_BT_ENABLED: n
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

ota:
  - platform: esphome
    password: !secret QMB_ota

# Enable Home Assistant API
api:
  encryption:
    key: "bCgjMAuWrpWokLfGt5g7bBSIvgPFbWUDa/G3G6tgLKg="  

# Minimal logger - no output on physical TX/RX pins
logger:
  level: DEBUG
  baud_rate: 0
  logs: 
    uart_debug: WARN
    modbus: WARN
    modbus_controller: WARN

uart:
  - id: mod_bus
    tx_pin: GPIO06        # → SP3485 RX-I
    rx_pin: GPIO05        # → SP3485 TX-O
    baud_rate: 19200
    data_bits: 8
    parity: EVEN
    stop_bits: 1
    #rx_full_threshold: 1
    rx_timeout: 50
    rx_buffer_size: 512
    flow_control_pin: GPIO7
 
    debug:
      direction: BOTH

# ====================== Modbus Server ======================
modbus:
  - id: quatt_modbus
    uart_id: mod_bus
    role: server
    send_wait_time: 50ms

